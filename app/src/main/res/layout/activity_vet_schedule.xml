<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".VetScheduleActivity">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/admin_dashboard" />

    <!-- Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <!-- Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_section"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/dark_grey"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back_schedule"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="Vet Appointments Schedule"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_section">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_table_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:backgroundTint="#26FFFFFF"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="horizontal">

                    <TableLayout
                        android:id="@+id/table_schedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <!-- Header Row -->
                        <TableRow
                            android:background="#40FFFFFF"
                            android:padding="12dp">
                            <TextView android:text="ANIMAL" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" android:textSize="12sp"/>
                            <TextView android:text="FARMER" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" android:textSize="12sp"/>
                            <TextView android:text="LOCATION" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" android:textSize="12sp"/>
                            <TextView android:text="DESCRIPTION" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" android:textSize="12sp"/>
                            <TextView android:text="SYMPTOMS" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" android:textSize="12sp"/>
                            <TextView android:text="REPORTED ON" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" android:textSize="12sp"/>
                            <TextView android:text="SCHEDULED VISIT" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" android:textSize="12sp"/>
                        </TableRow>

                    </TableLayout>
                </HorizontalScrollView>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_empty_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:gravity="center"
                android:text="No scheduled visits found."
                android:textColor="@color/white"
                android:alpha="0.6"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
